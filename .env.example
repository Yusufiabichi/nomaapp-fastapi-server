# ---- Cloudflare R2 (S3-compatible) ----
# R2 S3 API endpoint for your account
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2 API token access key ID
R2_ACCESS_KEY=
# R2 API token secret
R2_SECRET_KEY=
# bucket holding manifest.json, router/ and experts/
R2_BUCKET_NAME=nomaapp-models
# seconds to wait for a connection to R2
R2_CONNECT_TIMEOUT_S=5
# seconds to wait on a read (model downloads)
R2_READ_TIMEOUT_S=60
# boto3 retry attempts per R2 call
R2_MAX_ATTEMPTS=3

# ---- OOD layer 1: crop router (Stage 2) ----
# below this max softmax prob -> crop_not_identified
ROUTER_CONFIDENCE_THRESHOLD=0.70
# catch-all router classes -> unsupported_crop
ROUTER_UNSUPPORTED_CLASSES=other,unknown,unsupported
# "no plant" router classes -> no_plant_detected
ROUTER_NO_PLANT_CLASSES=no_plant,not_plant,background

# ---- OOD layer 2: expert models (Stage 4) ----
# T in E(x) = -T * logsumexp(logits / T)
ENERGY_TEMPERATURE=1.0
# reject if energy > this. Tune on a validation set!
ENERGY_OOD_THRESHOLD=0.0
# fallback: reject if max prob < this (when no logits available)
DISEASE_CONFIDENCE_THRESHOLD=0.50
# auto | logits | probabilities  (what the ONNX models emit)
MODEL_OUTPUT_TYPE=auto

# ---- Model cache ----
# expert models kept in RAM (LRU eviction beyond this)
MAX_WARM_EXPERTS=3
# disk cache directory (mirror of the bucket layout)
MODEL_CACHE_DIR=model_cache

# ---- Stage 1: image quality ----
# Laplacian variance below this -> blurry
BLUR_THRESHOLD=50.0
# larger uploads are rejected
MAX_UPLOAD_MB=10
# shorter side below this -> too small
MIN_IMAGE_SIDE_PX=100
# mean gray level below this -> too dark
MIN_BRIGHTNESS=20
# mean gray level above this -> overexposed
MAX_BRIGHTNESS=235
# blur/brightness measured on a copy downscaled to this size
QUALITY_ANALYSIS_MAX_SIDE_PX=512

# ---- Admin ----
# X-Admin-Key for DELETE /cache/{crop}. Empty = admin endpoints disabled
ADMIN_KEY=

# ---- App ----
# HTTP port (Railway sets this automatically)
PORT=8000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
